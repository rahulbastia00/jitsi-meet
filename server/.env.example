# Django Secret Key (Generate a random 50+ character string for production)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Debug Mode (set to False in production)
DEBUG=True

# Allowed Hosts (comma-separated list of hostnames/IPs)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Neon PostgreSQL)
# Format: postgresql://[user]:[password]@[endpoint-pooler].region.aws.neon.tech/[dbname]?sslmode=require
# If left unset, local development defaults to SQLite
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Redis Configuration (Used for OTP digests, rate limits, and tokens)
REDIS_URL=redis://127.0.0.1:6379/0

# Resend Email Delivery Configuration
# Obtain your API key from https://resend.com/api-keys
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz
DEFAULT_FROM_EMAIL=Auth <noreply@yourdomain.com>

# CORS & CSRF Origins (comma-separated list of allowed frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cookie Configuration
# SameSite policy: Lax, Strict, or None (if cross-site with Secure=True)
AUTH_COOKIE_SAMESITE=Lax
# Leave blank for local development, set to your top-level domain in production (e.g. .yourdomain.com)
AUTH_COOKIE_DOMAIN=

# Number of reverse proxies in front of Django (e.g. 1 for Nginx/Cloudflare, 0 for direct connection)
NUM_PROXIES=0
